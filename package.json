{
  "name": "dao-den-long",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dao Den Long - 3D lantern game with deterministic headless mode",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "preview": "vite preview",
    "headless": "node src/headless/cli.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "bench": "node scripts/bench.ts --seed 42 --duration 30 --out bench.json",
    "soak": "node --expose-gc scripts/soak.ts --seed 7 --nights 10 --out soak.json",
    "proof": "node scripts/proof3.ts",
    "proof:phase3": "node scripts/proof3.ts",
    "proof:phase2": "node scripts/proof2.ts",
    "fps": "node scripts/fps.ts",
    "screens": "node scripts/screens.ts",
    "proof:phase1": "node scripts/proof.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.187.0",
    "puppeteer-core": "^25.18.1",
    "typescript": "^5.6.0",
    "vite": "^8.3.8"
  },
  "license": "MIT",
  "dependencies": {
    "three": "^0.187.0"
  }
}
